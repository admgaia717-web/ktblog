<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f5f0eb"/>
      <stop offset="100%" style="stop-color:#e8dfd7"/>
    </linearGradient>
    <linearGradient id="spacex" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#005288"/>
      <stop offset="100%" style="stop-color:#003d66"/>
    </linearGradient>
    <linearGradient id="china" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#d4652a"/>
      <stop offset="100%" style="stop-color:#b85020"/>
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#bg)" rx="12"/>
  
  <!-- Title -->
  <text x="400" y="40" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" font-weight="bold" fill="#333">ブースター回収方式比較</text>
  <text x="400" y="62" text-anchor="middle" font-family="Arial, sans-serif" font-size="13" fill="#666">SpaceX 展開脚方式 vs 中国 ネット捕捉方式</text>
  
  <!-- SpaceX column -->
  <rect x="30" y="80" width="350" height="380" rx="8" fill="#fff" stroke="#005288" stroke-width="2"/>
  <rect x="30" y="80" width="350" height="40" rx="8" fill="url(#spacex)"/>
  <text x="205" y="105" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#fff">SpaceX 展開脚方式</text>
  
  <!-- China column -->
  <rect x="420" y="80" width="350" height="380" rx="8" fill="#fff" stroke="#d4652a" stroke-width="2"/>
  <rect x="420" y="80" width="350" height="40" rx="8" fill="url(#china)"/>
  <text x="595" y="105" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#fff">中国 ネット捕捉方式</text>
  
  <!-- SpaceX features -->
  <text x="50" y="140" font-family="Arial, sans-serif" font-size="13" fill="#333">✅ 展開脚（約2.5トン）で垂直着陸</text>
  <text x="50" y="165" font-family="Arial, sans-serif" font-size="13" fill="#333">✅ 陸上パッドまたは無人船上に着陸</text>
  <text x="50" y="190" font-family="Arial, sans-serif" font-size="13" fill="#333">✅ 着陸精度の許容範囲：広い</text>
  <text x="50" y="215" font-family="Arial, sans-serif" font-size="13" fill="#333">✅ 荒天時マージン：大きい</text>
  <text x="50" y="240" font-family="Arial, sans-serif" font-size="13" fill="#333">✅ 実績：635回以上成功（2026年）</text>
  <text x="50" y="265" font-family="Arial, sans-serif" font-size="13" fill="#333">✅ 着陸成功率：&gt;99%</text>
  
  <!-- China features -->
  <text x="440" y="140" font-family="Arial, sans-serif" font-size="13" fill="#333">✅ 展開脚なし（構造軽量化）</text>
  <text x="440" y="165" font-family="Arial, sans-serif" font-size="13" fill="#333">✅ 海上ネットでブースター捕捉</text>
  <text x="440" y="190" font-family="Arial, sans-serif" font-size="13" fill="#333">❌ 着陸精度：極めて高精度要求</text>
  <text x="440" y="215" font-family="Arial, sans-serif" font-size="13" fill="#333">❌ ネット有効範囲：約30m</text>
  <text x="440" y="240" font-family="Arial, sans-serif" font-size="13" fill="#333">❌ 海況依存性：より厳しい</text>
  <text x="440" y="265" font-family="Arial, sans-serif" font-size="13" fill="#333">❌ 実績：今回が初成功（1回）</text>
  <text x="440" y="290" font-family="Arial, sans-serif" font-size="13" fill="#333">❌ 大型化への対応：未実証</text>
  
  <!-- Divider -->
  <line x1="50" y1="310" x2="370" y2="310" stroke="#ddd" stroke-width="1"/>
  <line x1="440" y1="310" x2="770" y2="310" stroke="#ddd" stroke-width="1"/>
  
  <!-- Cost comparison -->
  <text x="205" y="335" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#005288">コスト構造</text>
  <text x="50" y="358" font-family="Arial, sans-serif" font-size="12" fill="#333">展開脚製造費：〜500万ドル/機</text>
  <text x="50" y="378" font-family="Arial, sans-serif" font-size="12" fill="#333">脚無し時：〜2.5トン分の</text>
  <text x="50" y="398" font-family="Arial, sans-serif" font-size="12" fill="#333">ペイロード容量増加</text>
  
  <text x="595" y="335" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#d4652a">コスト構造</text>
  <text x="440" y="358" font-family="Arial, sans-serif" font-size="12" fill="#333">ネットプラットフォーム建造費：</text>
  <text x="440" y="378" font-family="Arial, sans-serif" font-size="12" fill="#333">無人船より小型で安価</text>
  <text x="440" y="398" font-family="Arial, sans-serif" font-size="12" fill="#333">段構造疲労：少ない可能性</text>
  
  <!-- Bottom note -->
  <text x="400" y="480" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="#999">出典：SpaceX公開情報・CALT発表資料・各種報道</text>
  
  <!-- VS badge -->
  <circle cx="400" cy="250" r="28" fill="#d4652a"/>
  <text x="400" y="256" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#fff">VS</text>
</svg>
