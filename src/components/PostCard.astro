---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, date, category, tags = [], eyecatch, excerpt } = post.data;
const formattedDate = date.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<article class="group flex flex-col gap-3">
  <a href={`/post/${post.slug}`} class="block">
    {eyecatch && (
      <div class="aspect-[1280/670] overflow-hidden rounded-lg bg-[var(--color-bg-secondary)] mb-3 ring-1 ring-[var(--color-border)]">
        <img
          src={eyecatch}
          alt={title}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
          loading="lazy"
        />
      </div>
    )}
    <div class="space-y-2">
      <h2
        class:list={[
          'font-[var(--font-serif)] font-bold tracking-tight group-hover:text-[var(--color-accent)] transition-colors leading-tight',
          featured ? 'text-2xl md:text-4xl' : 'text-lg md:text-xl',
        ]}
      >
        {title}
      </h2>
      {excerpt && (
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed line-clamp-2">{excerpt}</p>
      )}
    </div>
  </a>

  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs">
    {category && (
      <a href={`/category/${encodeURIComponent(category)}`} class="text-[var(--color-accent)] tracking-wider uppercase font-medium hover:opacity-80 transition-opacity">
        {category}
      </a>
    )}
    <span class="text-[var(--color-border)]">·</span>
    <time datetime={date.toISOString()} class="text-[var(--color-text-muted)]">{formattedDate}</time>
  </div>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.slice(0, 5).map((tag) => (
        <a href={`/tag/${encodeURIComponent(tag)}`} class="inline-flex px-2 py-0.5 rounded text-xs border border-[var(--color-border)] bg-[var(--color-bg-secondary)] text-[var(--color-text-muted)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors">
          #{tag}
        </a>
      ))}
    </div>
  )}
</article>
