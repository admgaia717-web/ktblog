---
interface Props {
  placeholder?: string;
  buttonText?: string;
  value?: string;
}

const { placeholder = 'キーワードを入力…', buttonText = '検索', value = '' } = Astro.props;
---
<form action="/search" method="get" class="search-box relative group">
  <input
    type="text"
    name="q"
    value={value}
    placeholder={placeholder}
    class="w-full px-5 py-4 pr-14 rounded-xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)] text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-accent)] focus:ring-1 focus:ring-[var(--color-accent)] transition-all text-lg"
    autocomplete="off"
  />
  <button
    type="submit"
    class="absolute right-3 top-1/2 -translate-y-1/2 p-2 rounded-lg text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:bg-[var(--color-bg)] transition-colors"
    aria-label={buttonText}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
  </button>
</form>
