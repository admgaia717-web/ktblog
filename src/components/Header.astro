---
const links = [
  { href: '/', label: 'Home' },
  { href: '/archive', label: 'Archive' },
  { href: '/categories', label: 'Categories' },
  { href: '/about', label: 'About' },
];
const currentPath = Astro.url.pathname;
---
<header class="border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 backdrop-blur-md sticky top-0 z-50">
  <nav class="mx-auto max-w-4xl px-5 py-5 flex items-center justify-between">
    <a href="/" class="font-[var(--font-serif)] text-xl font-bold tracking-tight hover:text-[var(--color-accent)] transition-colors">
      KTblog
    </a>
    <div class="flex items-center gap-6">
      <a
        href="/search"
        class:list={[
          'hover:text-[var(--color-accent)] transition-colors',
          currentPath === '/search' && 'text-[var(--color-accent)]',
        ]}
        aria-label="Search"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </a>
      <ul class="hidden sm:flex gap-6 text-sm">
        {links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                'hover:text-[var(--color-accent)] transition-colors',
                currentPath === href && 'text-[var(--color-accent)]',
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>
