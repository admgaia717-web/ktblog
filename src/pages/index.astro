---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import SearchBox from '../components/SearchBox.astro';
import { getCollection } from 'astro:content';
import { groupPostsByCategory } from '../lib/categories';

const allPosts = await getCollection('posts');
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const POSTS_PER_PAGE = 12;
const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
const currentPage = 1;

const featured = posts[0];
const pagePosts = posts.slice(1, POSTS_PER_PAGE + 1);

const categoryGroups = groupPostsByCategory(allPosts);
const topCategories = categoryGroups.slice(0, 8);

// タグクラウド用集計
const tagCounts: Record<string, number> = {};
for (const post of allPosts) {
  for (const tag of post.data.tags || []) {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  }
}
const topTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 24);
const maxTagCount = topTags[0]?.[1] || 1;
---
<BaseLayout title="Home">
  <!-- Hero -->
  <section class="mb-16 md:mb-20 space-y-6">
    <div class="space-y-3">
      <p class="text-xs tracking-[0.25em] uppercase text-[var(--color-accent)]">Thoughts &middot; Records &middot; Archive</p>
      <h1 class="font-[var(--font-serif)] text-5xl md:text-7xl font-bold tracking-tight leading-[1.05]">
        KTblog
      </h1>
      <p class="text-[var(--color-text-muted)] max-w-2xl text-lg leading-relaxed">
        思想と記録のアーカイブ。技術、文化、デザイン、戦略について、静かに、深く、書き留める。
      </p>
    </div>

    <div class="max-w-2xl">
      <SearchBox placeholder="683件の記事から検索…" />
    </div>

    <div class="flex flex-wrap gap-6 text-sm text-[var(--color-text-muted)]">
      <div class="flex items-center gap-2">
        <span class="text-2xl font-[var(--font-serif)] font-bold text-[var(--color-text)]">{posts.length}</span>
        <span>記事</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-2xl font-[var(--font-serif)] font-bold text-[var(--color-text)]">{categoryGroups.length}</span>
        <span>カテゴリ</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-2xl font-[var(--font-serif)] font-bold text-[var(--color-text)]">{Object.keys(tagCounts).length}</span>
        <span>タグ</span>
      </div>
    </div>
  </section>

  <!-- Category Index -->
  <section class="mb-16 md:mb-20">
    <div class="flex items-baseline justify-between mb-5">
      <p class="text-xs tracking-[0.25em] uppercase text-[var(--color-accent)]">Categories</p>
      <a href="/categories" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors">全カテゴリ →</a>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      {topCategories.map((cat) => (
        <a href={`/category/${encodeURIComponent(cat.name)}`} class="group block p-4 rounded-lg bg-[var(--color-bg-secondary)] border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-colors">
          <span class="block font-[var(--font-serif)] font-bold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors truncate">{cat.name}</span>
          <span class="block text-xs text-[var(--color-text-muted)] mt-1">{cat.posts.length}件</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Tag Cloud -->
  {topTags.length > 0 && (
    <section class="mb-16 md:mb-20">
      <div class="flex items-baseline justify-between mb-5">
        <p class="text-xs tracking-[0.25em] uppercase text-[var(--color-accent)]">Tags</p>
        <a href="/search" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors">タグで探す →</a>
      </div>
      <div class="flex flex-wrap gap-2">
        {topTags.map(([tag, count]) => {
          const size = 0.75 + (count / maxTagCount) * 0.5;
          return (
            <a
              href={`/tag/${encodeURIComponent(tag)}`}
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-secondary)] text-[var(--color-text)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
              style={`font-size: ${size}rem`}
            >
              #{tag}
              <span class="text-[var(--color-text-muted)] text-xs">{count}</span>
            </a>
          );
        })}
      </div>
    </section>
  )}

  {featured && (
    <section class="mb-16 md:mb-20">
      <p class="text-xs tracking-[0.25em] uppercase text-[var(--color-accent)] mb-6">Featured</p>
      <PostCard post={featured} featured={true} />
    </section>
  )}

  {pagePosts.length > 0 && (
    <section>
      <div class="flex items-baseline justify-between mb-6">
        <p class="text-xs tracking-[0.25em] uppercase text-[var(--color-accent)]">Recent Posts</p>
        <a href="/archive" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors">全記事 →</a>
      </div>
      <div class="grid md:grid-cols-2 gap-10">
        {pagePosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </section>
  )}

  {totalPages > 1 && (
    <nav class="mt-16 flex items-center justify-center gap-2">
      <span class="px-3 py-2 text-sm text-[var(--color-text-muted)] cursor-default">
        1 / {totalPages}
      </span>
      <a href="/page/2" class="px-4 py-2 rounded-lg bg-[var(--color-bg-secondary)] border border-[var(--color-border)] text-sm text-[var(--color-text)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors">
        次へ →
      </a>
    </nav>
  )}
</BaseLayout>
