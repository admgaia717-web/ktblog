---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { groupPostsByCategory } from '../lib/categories';

const allPosts = await getCollection('posts');
const categoryGroups = groupPostsByCategory(allPosts);
const totalPosts = allPosts.length;
---
<BaseLayout title="Categories">
  <header class="mb-12 md:mb-16 space-y-3">
    <p class="text-xs tracking-[0.25em] uppercase text-[var(--color-accent)]">Categories</p>
    <h1 class="font-[var(--font-serif)] text-4xl md:text-5xl font-bold tracking-tight">Topics</h1>
    <p class="text-[var(--color-text-muted)]">{categoryGroups.length}カテゴリ · {totalPosts}件の記事</p>
  </header>

  <div class="space-y-16 md:space-y-20">
    {categoryGroups.map((group) => (
      <section id={encodeURIComponent(group.name)} class="scroll-mt-24">
        <div class="flex items-end justify-between mb-6 pb-4 border-b-2 border-[var(--color-border)]">
          <div>
            <h2 class="font-[var(--font-serif)] text-2xl md:text-4xl font-bold tracking-tight">{group.name}</h2>
            <p class="text-sm text-[var(--color-text-muted)] mt-1">最新6件を表示</p>
          </div>
          <a href={`/category/${encodeURIComponent(group.name)}`} class="text-sm text-[var(--color-accent)] hover:opacity-80 transition-opacity">
            全{group.posts.length}件 →
          </a>
        </div>
        <div class="grid md:grid-cols-2 gap-8 md:gap-10">
          {group.posts.slice(0, 6).map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
