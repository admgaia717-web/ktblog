# HTML・拡張子なしページ: エッジに長く溜めない（デプロイ後すぐ反映させる）
/*
  Cache-Control: public, max-age=0, must-revalidate

# ハッシュ付き静的アセットは長期キャッシュ（/* の値を ! で解除してから設定）
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
